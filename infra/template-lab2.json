{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "AWS Serverless Data Lake Lab 2 - encrypted S3 data storage, access logging, and least-privilege Glue execution roles. NOTE: deploy with CAPABILITY_NAMED_IAM.",
  "Resources": {
    "SDLS3Bucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Fn::Join": [
            "-", [
              "sdl-immersion-day",
              {
                "Ref": "AWS::AccountId"
              }
            ]
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      }
    },
    "SDLGlueBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "SDL-GlueBoundary",
        "Description": "Permissions boundary limiting SDL-GlueRole to workshop catalog, S3, logging, metrics, and Lake Formation data access",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "WorkshopGlueCatalog",
              "Effect": "Allow",
              "Action": [
                "glue:BatchCreatePartition",
                "glue:BatchDeletePartition",
                "glue:BatchGetPartition",
                "glue:CreatePartition",
                "glue:CreateTable",
                "glue:DeletePartition",
                "glue:GetDatabase",
                "glue:GetDatabases",
                "glue:GetPartition",
                "glue:GetPartitions",
                "glue:GetTable",
                "glue:GetTables",
                "glue:GetTableVersion",
                "glue:GetTableVersions",
                "glue:UpdatePartition",
                "glue:UpdateTable"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:catalog"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:database/default"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:database/sdl-demo-data"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:table/sdl-demo-data/*"
                }
              ]
            },
            {
              "Sid": "LakeFormationDataAccess",
              "Effect": "Allow",
              "Action": "lakeformation:GetDataAccess",
              "Resource": "*"
            },
            {
              "Sid": "GlueMetrics",
              "Effect": "Allow",
              "Action": "cloudwatch:PutMetricData",
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "cloudwatch:namespace": "Glue"
                }
              }
            },
            {
              "Sid": "GlueLogs",
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws-glue/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws-glue/*:*"
                }
              ]
            },
            {
              "Sid": "WorkshopAndGlueAssetBuckets",
              "Effect": "Allow",
              "Action": [
                "s3:GetBucketLocation",
                "s3:ListBucket",
                "s3:ListBucketMultipartUploads"
              ],
              "Resource": [
                {
                  "Fn::GetAtt": ["SDLS3Bucket", "Arn"]
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::aws-glue-assets-${AWS::AccountId}-${AWS::Region}"
                }
              ]
            },
            {
              "Sid": "WorkshopAndGlueAssetObjects",
              "Effect": "Allow",
              "Action": [
                "s3:AbortMultipartUpload",
                "s3:DeleteObject",
                "s3:GetObject",
                "s3:PutObject"
              ],
              "Resource": [
                {
                  "Fn::Sub": "${SDLS3Bucket.Arn}/raw/*"
                },
                {
                  "Fn::Sub": "${SDLS3Bucket.Arn}/scripts/*"
                },
                {
                  "Fn::Sub": "${SDLS3Bucket.Arn}/compressed-parquet/*"
                },
                {
                  "Fn::Sub": "${SDLS3Bucket.Arn}/output-etl-nb-jobs/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::aws-glue-assets-${AWS::AccountId}-${AWS::Region}/*"
                }
              ]
            },
            {
              "Sid": "GlueInteractiveSessionExecution",
              "Effect": "Allow",
              "Action": [
                "glue:CreateSession",
                "glue:DeleteSession",
                "glue:GetSession",
                "glue:GetStatement",
                "glue:ListStatements",
                "glue:RunStatement",
                "glue:StopSession",
                "glue:TagResource"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:session/*"
              }
            },
            {
              "Sid": "PassGlueRoleForInteractiveSessions",
              "Effect": "Allow",
              "Action": "iam:PassRole",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/SDL-GlueRole"
              },
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "glue.amazonaws.com"
                }
              }
            }
          ]
        }
      }
    },
    "SDLGlueRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "SDL-GlueRole",
        "PermissionsBoundary": {
          "Ref": "SDLGlueBoundary"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "glue.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        }
      }
    },
    "SDLGlueExecutionPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "GlueWorkshopExecutionPermissions",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "WorkshopGlueCatalog",
              "Effect": "Allow",
              "Action": [
                "glue:BatchCreatePartition",
                "glue:BatchDeletePartition",
                "glue:BatchGetPartition",
                "glue:CreatePartition",
                "glue:CreateTable",
                "glue:DeletePartition",
                "glue:GetDatabase",
                "glue:GetDatabases",
                "glue:GetPartition",
                "glue:GetPartitions",
                "glue:GetTable",
                "glue:GetTables",
                "glue:GetTableVersion",
                "glue:GetTableVersions",
                "glue:UpdatePartition",
                "glue:UpdateTable"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:catalog"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:database/default"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:database/sdl-demo-data"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:table/sdl-demo-data/*"
                }
              ]
            },
            {
              "Sid": "LakeFormationDataAccess",
              "Effect": "Allow",
              "Action": "lakeformation:GetDataAccess",
              "Resource": "*"
            },
            {
              "Sid": "GlueMetrics",
              "Effect": "Allow",
              "Action": "cloudwatch:PutMetricData",
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "cloudwatch:namespace": "Glue"
                }
              }
            },
            {
              "Sid": "GlueLogs",
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws-glue/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws-glue/*:*"
                }
              ]
            },
            {
              "Sid": "GlueInteractiveSessionExecution",
              "Effect": "Allow",
              "Action": [
                "glue:CreateSession",
                "glue:DeleteSession",
                "glue:GetSession",
                "glue:GetStatement",
                "glue:ListStatements",
                "glue:RunStatement",
                "glue:StopSession",
                "glue:TagResource"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:session/*"
              }
            },
            {
              "Sid": "PassGlueRoleForInteractiveSessions",
              "Effect": "Allow",
              "Action": "iam:PassRole",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/SDL-GlueRole"
              },
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "glue.amazonaws.com"
                }
              }
            }
          ]
        },
        "Roles": [
          {
            "Ref": "SDLGlueRole"
          }
        ]
      }
    },
    "SDLGlueS3Policy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "GlueS3BucketPermissions",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "GlueBucketLevel",
              "Effect": "Allow",
              "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation",
                "s3:ListBucketMultipartUploads"
              ],
              "Resource": [
                {
                  "Fn::GetAtt": ["SDLS3Bucket", "Arn"]
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::aws-glue-assets-${AWS::AccountId}-${AWS::Region}"
                }
              ]
            },
            {
              "Sid": "GlueObjectLevel",
              "Effect": "Allow",
              "Action": [
                "s3:AbortMultipartUpload",
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
              ],
              "Resource": [
                {
                  "Fn::Sub": "${SDLS3Bucket.Arn}/raw/*"
                },
                {
                  "Fn::Sub": "${SDLS3Bucket.Arn}/scripts/*"
                },
                {
                  "Fn::Sub": "${SDLS3Bucket.Arn}/compressed-parquet/*"
                },
                {
                  "Fn::Sub": "${SDLS3Bucket.Arn}/output-etl-nb-jobs/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::aws-glue-assets-${AWS::AccountId}-${AWS::Region}/*"
                }
              ]
            }
          ]
        },
        "Roles": [
          {
            "Ref": "SDLGlueRole"
          }
        ]
      }
    }
   },
  "Outputs": {
    "SDLDataBucketName": {
      "Description": "Serverless Data Lake data bucket",
      "Value": {
        "Ref": "SDLS3Bucket"
      }
    },
    "SDLGlueRoleArn": {
      "Description": "IAM role ARN for AWS Glue",
      "Value": {
        "Fn::GetAtt": ["SDLGlueRole", "Arn"]
      }
    },
    "SDLGlueBoundaryArn": {
      "Description": "Permissions boundary managed policy ARN for SDL-GlueRole",
      "Value": {
        "Ref": "SDLGlueBoundary"
      }
    }
  }
}
